# ─── Resend — Email ───────────────────────────────────────────────────────────
#
# RESEND_API_KEY
#   Your Resend API key. Found at: https://resend.com/api-keys
#   Starts with "re_"
#
RESEND_API_KEY=

# RESEND_AUDIENCE_ID (optional)
#   Only needed if you are using Resend Audiences or Segments.
#   The signup route uses the global Resend Contacts API and does NOT
#   require this variable. If you set it, it is ignored by the current
#   implementation but reserved for future segmentation work.
#
# RESEND_AUDIENCE_ID=

# ─── Contact form ─────────────────────────────────────────────────────────────
#
# CONTACT_TO_EMAIL
#   Where contact form submissions are delivered.
#
CONTACT_TO_EMAIL=hello@shaggyinkfarms.com

# CONTACT_FROM_EMAIL
#   The "From" address on outbound emails. Must use a domain verified in Resend.
#   Format: Display Name <address@yourdomain.com>
#
CONTACT_FROM_EMAIL=Shaggy Ink Farms <updates@shaggyinkfarms.com>
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-D192EV37FB
