# ─── Resend — Email & Audience ───────────────────────────────────────────────
#
# RESEND_API_KEY
#   Your Resend API key. Found at: https://resend.com/api-keys
#   Starts with "re_"
#
RESEND_API_KEY=

# RESEND_AUDIENCE_ID
#   The UUID of your Resend Audience. THIS MUST BE THE UUID — NOT THE DISPLAY NAME.
#
#   How to find it:
#     1. Go to https://resend.com/audiences
#     2. Click on your audience
#     3. The ID is shown under the audience name — it looks like:
#        xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
#     4. Copy that UUID and paste it here.
#
#   Common mistake: setting this to the audience display name (e.g. "Resend → Audience"
#   or "Shaggy Ink Farms List"). That causes the API URL to be invalid and returns 502.
#
RESEND_AUDIENCE_ID=

# ─── Contact form ─────────────────────────────────────────────────────────────
#
# CONTACT_TO_EMAIL
#   Where contact form submissions are delivered.
#
CONTACT_TO_EMAIL=hello@shaggyinkfarms.com

# CONTACT_FROM_EMAIL
#   The "From" address on outbound emails. Must use a domain verified in Resend.
#   Format: Display Name <address@yourdomain.com>
#
CONTACT_FROM_EMAIL=Shaggy Ink Farms <updates@shaggyinkfarms.com>
